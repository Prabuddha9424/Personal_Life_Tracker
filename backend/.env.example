NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/life-tracker
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
# Reverse proxies in front of the API. Use 0 when nothing is in front (local dev, or a bare port), 1 behind one proxy. The production value is verified after deploy (docs/runbook.md).
TRUST_PROXY_HOPS=1
# Shared secret for the scheduled reminder job. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
CLIENT_URL=http://localhost:5173
# Local development uses a mail catcher on port 1025 (for example Mailpit).
# Production uses the Brevo SMTP relay smtp-relay.brevo.com on port 2525,
# because Render's free tier blocks ports 25, 465 and 587.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Life Tracker <no-reply@example.com>"
